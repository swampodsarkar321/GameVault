# FS Plus checker — optional backend API (Realtime not needed for this)
# Expected: { "reachable": true|false }
# VITE_FS_CHECKER_URL=https://your-backend.com/api/check-fs-plus
# Dev proxy: /api/check-fs-plus -> https://fs.plus.net.bd/Games/
VITE_FS_CHECKER_URL=/api/check-fs-plus
